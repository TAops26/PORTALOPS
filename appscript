const SHEETS = {
  reportes:    '1MTLKGySfwz3GN3qb2xXEUhTen97uoXOVGz0UxHzWkqQ',
  desempeno:   '16vB-bmPUfpSlQtwy1bKAY2hR_jwMXbmAF8TTiFpfqwk',
  insumos:     '1uU2En45IfGDNnlI_buwu8r2bq9C-CQz9GVwOHf-8grw',
  inventarios: '119H6cjpELy4QQQ8mFfH51K2eWjwH8JD66gASG9Jddbk',
};

// ── GET: leer usuarios o config ──
function doGet(e) {
  const action = (e && e.parameter && e.parameter.action) ? e.parameter.action : '';

  let resultado;
  if (action === 'get_usuarios') {
    resultado = responderUsuarios();
  } else if (action === 'get_config_reportes') {
    resultado = responderConfigReportes();
  } else if (action === 'get_colabs') {
    resultado = responderColabs();
  } else if (action === 'get_averias') {
    resultado = responderAverias();
  } else if (action === 'get_guest_reports') {
    resultado = responderGuestReports();
  } else {
    resultado = { ok: false, error: 'Acción no reconocida: ' + action };
  }

  return ContentService
    .createTextOutput(JSON.stringify(resultado))
    .setMimeType(ContentService.MimeType.JSON);
}

// ── POST: recibir datos ──
function doPost(e) {
  try {
    const payload = JSON.parse(e.postData.contents);
    const type    = payload.type || '';

    let resultado;
    if (type === 'reporte' || type === 'checklist') {
      resultado = guardarReporte(payload);
    } else if (type === 'evaluacion') {
      resultado = guardarDesempeno(payload);
    } else if (type === 'solicitud-insumos') {
      resultado = guardarInsumo(payload);
    } else if (type === 'inventario') {
      resultado = guardarInventario(payload);
    } else if (type === 'actualizar_averia') {
      resultado = actualizarEstadoAveria(payload);
    } else if (type === 'guest_report') {
      resultado = guardarGuestReport(payload);
    } else if (type === 'completar_guest_report') {
      resultado = completarGuestReport(payload);
    } else {
      resultado = { ok: false, error: 'Tipo no reconocido: ' + type };
    }

    return ContentService
      .createTextOutput(JSON.stringify(resultado))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({ ok: false, error: err.message }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// ══════════════════════════════════════════════════════════════
// USUARIOS
// ══════════════════════════════════════════════════════════════
function responderUsuarios() {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.desempeno);
    const hoja = ss.getSheetByName('Usuarios');
    if (!hoja) return { ok: false, error: 'Pestaña Usuarios no encontrada' };

    const datos = hoja.getDataRange().getValues();
    if (datos.length < 2) return { ok: true, usuarios: [] };

    const headers  = datos[0].map(h => h.toString().toLowerCase().trim());
    const usuarios = datos.slice(1)
      .filter(row => row[0])
      .map(row => {
        const obj = {};
        headers.forEach((h, i) => obj[h] = row[i] ? row[i].toString().trim() : '');
        return obj;
      });

    return { ok: true, usuarios };

  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// ══════════════════════════════════════════════════════════════
// COLABORADORES — lee columna H de Config directamente
// ══════════════════════════════════════════════════════════════
function responderColabs() {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('Config');
    if (!hoja) return { ok: false, error: 'Pestaña Config no encontrada' };

    const datos = hoja.getDataRange().getValues();
    // Column H = index 7
    const colabs = datos.slice(1)
      .map(row => row[7] ? row[7].toString().trim() : '')
      .filter(Boolean);

    return { ok: true, colabs };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// ══════════════════════════════════════════════════════════════
// AVERÍAS — lectura de pendientes y actualización de estado
// ══════════════════════════════════════════════════════════════
function responderAverias() {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('MANTENIMIENTO - REPORTE DE AVERÍA');
    if (!hoja || hoja.getLastRow() < 2) return { ok: true, averias: [] };

    const datos   = hoja.getDataRange().getValues();
    const headers = datos[0];

    // Build index with normalized keys to handle accent/encoding variants
    const idx = {};
    headers.forEach((h, i) => {
      idx[h] = i;
      idx[h.normalize('NFC')] = i;
      idx[h.normalize('NFD')] = i;
      // Also index by simplified version
      idx[h.replace(/[áàä]/gi,'a').replace(/[éèë]/gi,'e').replace(/[íìï]/gi,'i')
           .replace(/[óòö]/gi,'o').replace(/[úùü]/gi,'u').toLowerCase()] = i;
    });

    // Helper: get value by multiple possible column names or fallback to position
    const col = (names, fallbackPos) => {
      for (const n of names) { if (idx[n] !== undefined) return idx[n]; }
      return fallbackPos;
    };

    // Column positions based on known header order:
    // Timestamp(0) Usuario(1) Colaborador(2) Fecha(3) Avería(4) Prioridad(5) Área(6) Cluster(7) Descripción(8) Estado(9) ID(10)
    const cId    = col(['ID'],                          10);
    const cTs    = col(['Timestamp'],                    0);
    const cUser  = col(['Usuario'],                      1);
    const cColab = col(['Colaborador'],                  2);
    const cFecha = col(['Fecha'],                        3);
    const cAv    = col(['Avería','Averia'],              4);
    const cPrio  = col(['Prioridad'],                    5);
    const cArea  = col(['Área','Area'],                  6);
    const cClust = col(['Cluster'],                      7);
    const cDesc  = col(['Descripción','Descripcion'],    8);
    const cEst   = col(['Estado'],                       9);

    const averias = datos.slice(1)
      .map(row => ({
        id:          String(row[cId]    || ''),
        timestamp:   String(row[cTs]    || ''),
        usuario:     String(row[cUser]  || ''),
        colaborador: String(row[cColab] || ''),
        fecha:       String(row[cFecha] || ''),
        averia:      String(row[cAv]    || ''),
        prioridad:   String(row[cPrio]  || ''),
        area:        String(row[cArea]  || ''),
        cluster:     String(row[cClust] || ''),
        descripcion: String(row[cDesc]  || ''),
        estado:      String(row[cEst]   || 'Pendiente'),
      }))
      .filter(a => a.id && a.estado !== 'Completada');

    return { ok: true, averias };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function actualizarEstadoAveria(payload) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('MANTENIMIENTO - REPORTE DE AVERÍA');
    if (!hoja) return { ok: false, error: 'Pestaña de averías no encontrada' };

    const idBuscado = payload.id || '';
    if (!idBuscado) return { ok: false, error: 'ID de avería no especificado' };

    const datos   = hoja.getDataRange().getValues();
    const headers = datos[0];
    const colId      = headers.indexOf('ID');
    const colEstado  = headers.indexOf('Estado');
    if (colId < 0 || colEstado < 0) return { ok: false, error: 'Columnas ID/Estado no encontradas' };

    for (let r = 1; r < datos.length; r++) {
      if (datos[r][colId] === idBuscado) {
        hoja.getRange(r + 1, colEstado + 1).setValue('Completada');
        return { ok: true };
      }
    }
    return { ok: false, error: 'Avería no encontrada: ' + idBuscado };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

