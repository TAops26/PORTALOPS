function guardarInventario(payload) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.inventarios);
    const tipo = payload.tipo || '';

    const hojaMap = {
      'ropa-cama':      'Ropa de Cama',
      'props-maloca':   'Props Maloca',
      'props-movement': 'Props Estudio de Movimiento',
      'campamento':     'Campamento',
    };
    const nombreHoja = hojaMap[tipo] || 'General';
    let hoja = ss.getSheetByName(nombreHoja);
    if (!hoja) hoja = ss.insertSheet(nombreHoja);

    const ts    = new Date();
    const items = payload.items || [];

    if (hoja.getLastRow() === 0) {
      hoja.appendRow([
        'Timestamp','Usuario','Tipo','Fecha','Observaciones',
        ...items.map(i => i.item)
      ]);
    }

    hoja.appendRow([
      Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss'),
      payload.usuario       || '',
      tipo,
      payload.fecha         || '',
      payload.observaciones || '',
      ...items.map(i => i.cantidad || 0),
    ]);

    return { ok: true };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}
