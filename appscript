function guardarInsumo(payload) {
  try {
    const ss         = SpreadsheetApp.openById(SHEETS.insumos);
    const dept       = payload.departamento || 'limpieza';
    const tipo       = payload.tipo || '';
    const datos = payload.datos || {};
    const items = datos.items   || [];

    let nombreHoja;
    if (tipo === 'herramientas') {
      nombreHoja = 'HERRAMIENTAS';
    } else if (tipo === 'cuadraciclo') {
      nombreHoja = 'USO DE CUADRACICLO';
    } else {
      nombreHoja = dept === 'mantenimiento' ? 'MANTENIMIENTO' : 'Limpieza';
    }

    // NOTA: en la versión anterior estas fotos (adjuntadas en los formularios
    // de materiales/cuadraciclo) se descartaban silenciosamente — nunca se
    // procesaban aquí. Ahora sí se suben y se organizan igual que el resto.
    const categoriaFotos = 'Insumos - ' + (tipo || 'solicitud');
    const fotosRes = procesarFotos_(datos.fotos, categoriaFotos, datos.colaborador);
    if (!fotosRes.ok) return { ok: false, error: fotosRes.error };
    const fotosUrls = fotosRes.urls.join(', ');

    let hoja = ss.getSheetByName(nombreHoja);
    if (!hoja) hoja = ss.insertSheet(nombreHoja);

    const ts    = new Date();
    const ts_str = Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

    if (tipo === 'herramientas') {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Colaborador','Fecha','Hora','Herramienta','Estado','Observaciones','Fotos']);
      }
      hoja.appendRow([
        ts_str, payload.usuario||'', datos.colaborador||'',
        datos.fecha||'', datos.hora||'', datos.area||'',
        datos.estado||'', datos.obs||'', fotosUrls,
      ]);
    } else if (tipo === 'cuadraciclo') {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Colaborador','Fecha','Hora','Cuadraciclo','Kilometraje Inicial','Observaciones','Fotos']);
      }
      hoja.appendRow([
        ts_str, payload.usuario||'', datos.colaborador||'',
        datos.fecha||'', datos.hora||'', datos.area||'',
        datos.desc||'', datos.obs||'', fotosUrls,
      ]);
    } else {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Departamento','Colaborador','Fecha','Prioridad','Observaciones','Items (JSON)','Cant. Items','Fotos']);
      }
      hoja.appendRow([
        ts_str, payload.usuario||'', dept,
        datos.colaborador||'', datos.fecha||'', datos.prior||'',
        datos.obs||'', JSON.stringify(items), items.length, fotosUrls,
      ]);
    }

    return { ok: true };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

