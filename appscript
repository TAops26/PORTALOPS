// GUEST REPORTS
// ══════════════════════════════════════════════════════════════
function guardarGuestReport(payload) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('GUEST REPORT');
    if (!hoja) return { ok: false, error: 'Pestaña GUEST REPORT no encontrada' };

    const ts     = new Date();
    const ts_str = Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    const idUnico = 'GR-' + ts.getTime();
    const datos  = payload.datos || {};
    // El huésped elige el departamento (Limpieza o Mantenimiento) en el guest portal.
    const departamento = (datos.departamento || 'Mantenimiento').toString().trim();

    let descEs = datos.descripcion || '';
    let areaEs = datos.area        || '';
    try {
      if (descEs) descEs = LanguageApp.translate(descEs, 'en', 'es');
      if (areaEs) areaEs = LanguageApp.translate(areaEs, 'en', 'es');
    } catch(e) {}

    // Escribe CADA VALOR EN LA COLUMNA QUE LE CORRESPONDE POR NOMBRE, no por
    // posición fija. Así no importa si "Departamento" quedó en la columna G
    // o en otra distinta — nunca queda desalineado con "Área"/"Estado"/etc.
    const headerRow = hoja.getLastRow() > 0 ? hoja.getRange(1, 1, 1, hoja.getLastColumn()).getValues()[0] : [];
    const headers   = headerRow.map(h => h.toString().trim());
    const valoresPorNombre = {
      'Timestamp':    ts_str,
      'Descripción':  descEs, 'Descripcion': descEs,
      'Área':         areaEs, 'Area': areaEs,
      'Estado':       'Pendiente',
      'ID':           idUnico,
      'Colaborador':  '',
      'Departamento': departamento,
    };

    let fila;
    if (headers.length) {
      fila = headers.map(h => (h in valoresPorNombre) ? valoresPorNombre[h] : '');
      // Si la hoja todavía no tiene columna "Departamento" (no se agregó el
      // encabezado), se agrega el valor al final para no perderlo — pero
      // recomendamos agregar el encabezado "Departamento" para que quede
      // ordenado y responderGuestReports() lo encuentre siempre por nombre.
      if (headers.indexOf('Departamento') === -1) fila.push(departamento);
    } else {
      // Hoja completamente vacía (sin encabezados): usa el orden esperado por defecto.
      fila = [ts_str, descEs, areaEs, 'Pendiente', idUnico, '', departamento];
    }

    hoja.appendRow(fila);
    return { ok: true, id: idUnico };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function responderGuestReports() {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('GUEST REPORT');
    if (!hoja || hoja.getLastRow() < 2) return { ok: true, reportes: [] };

    const datos   = hoja.getDataRange().getValues();
    const headers = datos[0].map(h => h.toString().trim());
    const idx = {};
    headers.forEach((h, i) => {
      idx[h] = i;
      idx[h.normalize('NFC')] = i;
      idx[h.replace(/[áéíóú]/gi, c => ({á:'a',é:'e',í:'i',ó:'o',ú:'u'}[c.toLowerCase()]||c)).toLowerCase()] = i;
    });

    const col = (names, fallback) => { for (const n of names) { if (idx[n] !== undefined) return idx[n]; } return fallback; };
    const cTs    = col(['Timestamp'],                   0);
    const cDesc  = col(['Descripción','Descripcion'],   1);
    const cArea  = col(['Área','Area'],                 2);
    const cEst   = col(['Estado'],                      3);
    const cId    = col(['ID'],                          4);
    const cColab = col(['Colaborador'],                 5);
    // Si no existe un encabezado "Departamento" con ese nombre exacto, se
    // asume que quedó en la última columna (así es como guardarGuestReport
    // la agrega cuando el encabezado no existe todavía en la hoja).
    const cDept  = col(['Departamento'],                headers.length);

    const reportes = datos.slice(1)
      .map(row => ({
        id:          String(row[cId]    || ''),
        timestamp:   row[cTs] ? Utilities.formatDate(new Date(row[cTs]), 'America/Costa_Rica', 'yyyy-MM-dd') : '',
        descripcion: String(row[cDesc]  || ''),
        area:        String(row[cArea]  || ''),
        estado:      String(row[cEst]   || 'Pendiente'),
        colaborador: String(row[cColab] || ''),
        // Reportes guardados antes de este cambio no tienen Departamento —
        // se asumen de Mantenimiento (comportamiento original) para no
        // perderlos ni mostrarlos mal clasificados.
        departamento: String(row[cDept] || 'Mantenimiento').trim() || 'Mantenimiento',
      }))
      .filter(r => r.id && r.estado !== 'Completada');

    return { ok: true, reportes };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function completarGuestReport(payload) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName('GUEST REPORT');
    if (!hoja) return { ok: false, error: 'Pestaña GUEST REPORT no encontrada' };

    const idBuscado    = payload.id          || '';
    const colaborador  = payload.colaborador || '';
    if (!idBuscado) return { ok: false, error: 'ID no especificado' };

    const datos    = hoja.getDataRange().getValues();
    const headers  = datos[0];
    const colId    = headers.indexOf('ID');
    const colEst   = headers.indexOf('Estado');
    const colColab = headers.indexOf('Colaborador');

    for (let r = 1; r < datos.length; r++) {
      if (datos[r][colId] === idBuscado) {
        hoja.getRange(r + 1, colEst   + 1).setValue('Completada');
        hoja.getRange(r + 1, colColab + 1).setValue(colaborador);

        const hojaAv = ss.getSheetByName('MANTENIMIENTO - REPORTE DE AVERÍA');
        if (hojaAv) {
          const ts     = new Date();
          const ts_str = Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
          const idAv   = 'AV-GR-' + ts.getTime();
          if (hojaAv.getLastRow() === 0) {
            hojaAv.appendRow(['Timestamp','Usuario','Colaborador','Fecha','Avería','Prioridad','Área','Cluster','Descripción','Estado','ID','Fotos']);
          }
          hojaAv.appendRow([
            ts_str,
            payload.usuario  || '',
            colaborador,
            ts_str,
            'Reporte de Huésped',
            'Prioridad',
            datos[r][headers.indexOf('Área')] || '',
            '',
            datos[r][headers.indexOf('Descripción')] || '',
            'Completada',
            idAv,
            '',
          ]);
        }
        return { ok: true };
      }
    }
    return { ok: false, error: 'Reporte no encontrado: ' + idBuscado };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

