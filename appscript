// ══════════════════════════════════════════════════════════════
// GUEST PORTAL — solicitudes (Tour / Lavandería / Transporte)
// Funciones genéricas: mismas 3 hojas comparten el mismo patrón de
// guardar / listar pendientes / marcar como completada.
// ══════════════════════════════════════════════════════════════

// Guarda una solicitud en la hoja indicada. `headers` define el orden de
// columnas (debe terminar siempre en Estado, ID). `payload.datos` trae los
// campos del formulario con llaves ya en español simple (ver cada caso en
// doPost). `prefijo` identifica el tipo de solicitud dentro del ID único.
function guardarSolicitud_(nombreHoja, headers, payload, prefijo) {
  try {
    const ss = SpreadsheetApp.openById(SHEETS.reportes);
    let hoja = ss.getSheetByName(nombreHoja);
    if (!hoja) hoja = ss.insertSheet(nombreHoja);
    if (hoja.getLastRow() === 0) hoja.appendRow(headers);

    const ts     = new Date();
    const ts_str = Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');
    const idUnico = prefijo + '-' + ts.getTime();
    const datos = payload.datos || {};

    let fila;
    if (nombreHoja === 'TOUR REQUESTS') {
      fila = [ts_str, datos.nombre || '', datos.habitacion || '', datos.tour || '', datos.fecha || '', datos.personas || '', datos.notas || '', 'Pendiente', idUnico];
    } else if (nombreHoja === 'LAVANDERIA') {
      fila = [ts_str, datos.nombre || '', datos.habitacion || '', datos.hora || '', datos.detalles || '', 'Pendiente', idUnico];
    } else if (nombreHoja === 'TRANSPORTE') {
      fila = [ts_str, datos.nombre || '', datos.habitacion || '', datos.destino || '', datos.fecha || '', datos.hora || '', datos.personas || '', datos.idaYVuelta || '', datos.notas || '', 'Pendiente', idUnico];
    } else {
      return { ok: false, error: 'Hoja de solicitud no reconocida: ' + nombreHoja };
    }

    hoja.appendRow(fila);
    return { ok: true, id: idUnico };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// Lee las solicitudes pendientes (Estado !== 'Completada') de cualquiera de
// las 3 hojas de solicitudes, normalizando a un mismo formato de salida.
function responderSolicitudes_(nombreHoja) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName(nombreHoja);
    if (!hoja || hoja.getLastRow() < 2) return { ok: true, solicitudes: [] };

    const datos   = hoja.getDataRange().getValues();
    const headers = datos[0].map(h => h.toString().trim());
    const idxOf = (nombre) => headers.indexOf(nombre);

    const cId  = idxOf('ID');
    const cEst = idxOf('Estado');

    const solicitudes = datos.slice(1)
      .map(row => {
        const obj = {};
        headers.forEach((h, i) => { obj[h] = row[i] !== undefined && row[i] !== null ? row[i] : ''; });
        obj.id     = String(row[cId]  || '');
        obj.estado = String(row[cEst] || 'Pendiente');
        return obj;
      })
      .filter(r => r.id && r.estado !== 'Completada');

    return { ok: true, solicitudes };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// Marca una solicitud (Tour/Lavandería/Transporte) como completada.
// payload debe incluir { hoja: 'TOUR REQUESTS' | 'LAVANDERIA' | 'TRANSPORTE', id: '...' }
function completarSolicitud_(payload) {
  try {
    const hojasValidas = ['TOUR REQUESTS', 'LAVANDERIA', 'TRANSPORTE'];
    const nombreHoja = payload.hoja || '';
    if (hojasValidas.indexOf(nombreHoja) === -1) {
      return { ok: false, error: 'Hoja de solicitud no válida: ' + nombreHoja };
    }
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const hoja = ss.getSheetByName(nombreHoja);
    if (!hoja) return { ok: false, error: 'Pestaña ' + nombreHoja + ' no encontrada' };

    const idBuscado = payload.id || '';
    if (!idBuscado) return { ok: false, error: 'ID no especificado' };

    const datos   = hoja.getDataRange().getValues();
    const headers = datos[0].map(h => h.toString().trim());
    const colId  = headers.indexOf('ID');
    const colEst = headers.indexOf('Estado');
    if (colId < 0 || colEst < 0) return { ok: false, error: 'Columnas ID/Estado no encontradas en ' + nombreHoja };

    for (let r = 1; r < datos.length; r++) {
      if (String(datos[r][colId]) === idBuscado) {
        hoja.getRange(r + 1, colEst + 1).setValue('Completada');
        return { ok: true };
      }
    }
    return { ok: false, error: 'Solicitud no encontrada: ' + idBuscado };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}
