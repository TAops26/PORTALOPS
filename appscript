// ── GET: leer usuarios o config ──
function doGet(e) {
  const action = (e && e.parameter && e.parameter.action) ? e.parameter.action : '';

  let resultado;
  if (action === 'get_usuarios') {
    resultado = responderUsuarios();
  } else if (action === 'get_config_reportes') {
    resultado = responderConfigReportes();
  } else if (action === 'get_colabs') {
    resultado = responderColabs();
  } else if (action === 'get_averias') {
    resultado = responderAverias();
  } else if (action === 'get_guest_reports') {
    resultado = responderGuestReports();
  } else if (action === 'get_today_farm') {
    resultado = responderTodayFarm();
  } else if (action === 'get_menu') {
    resultado = responderMenu();
  } else if (action === 'get_tours') {
    resultado = responderTours();
  } else if (action === 'get_emergency_contacts') {
    resultado = responderEmergencyContacts();
  } else if (action === 'get_tour_requests') {
    resultado = responderSolicitudes_('TOUR REQUESTS');
  } else if (action === 'get_laundry_requests') {
    resultado = responderSolicitudes_('LAVANDERIA');
  } else if (action === 'get_transport_requests') {
    resultado = responderSolicitudes_('TRANSPORTE');
  } else {
    resultado = { ok: false, error: 'Acción no reconocida: ' + action };
  }

  return ContentService
    .createTextOutput(JSON.stringify(resultado))
    .setMimeType(ContentService.MimeType.JSON);
}

// ── POST: recibir datos ──
function doPost(e) {
  try {
    const payload = JSON.parse(e.postData.contents);
    const type    = payload.type || '';

    let resultado;
    if (type === 'login') {
      resultado = validarLogin(payload);
    } else if (type === 'reporte' || type === 'checklist') {
      resultado = guardarReporte(payload);
    } else if (type === 'evaluacion') {
      resultado = guardarDesempeno(payload);
    } else if (type === 'solicitud-insumos') {
      resultado = guardarInsumo(payload);
    } else if (type === 'inventario') {
      resultado = guardarInventario(payload);
    } else if (type === 'actualizar_averia') {
      resultado = actualizarEstadoAveria(payload);
    } else if (type === 'guest_report') {
      resultado = guardarGuestReport(payload);
    } else if (type === 'completar_guest_report') {
      resultado = completarGuestReport(payload);
    } else if (type === 'tour_request') {
      resultado = guardarSolicitud_('TOUR REQUESTS', ['Timestamp','Nombre Huésped','Habitación','Tour','Fecha Preferida','Cantidad Personas','Notas','Estado','ID'], payload, 'TR');
    } else if (type === 'laundry_request') {
      resultado = guardarSolicitud_('LAVANDERIA', ['Timestamp','Nombre Huésped','Habitación','Hora de Recogida','Detalles','Estado','ID'], payload, 'LV');
    } else if (type === 'transport_request') {
      resultado = guardarSolicitud_('TRANSPORTE', ['Timestamp','Nombre Huésped','Habitación','Destino','Fecha','Hora','Cantidad Personas','Ida y Vuelta','Notas','Estado','ID'], payload, 'TP');
    } else if (type === 'completar_solicitud') {
      resultado = completarSolicitud_(payload);
    } else {
      resultado = { ok: false, error: 'Tipo no reconocido: ' + type };
    }

    return ContentService
      .createTextOutput(JSON.stringify(resultado))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({ ok: false, error: err.message }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// ══════════════════════════════════════════════════════════════
// AUTENTICACIÓN (NUEVO)
// La validación de usuario/contraseña ocurre exclusivamente aquí.
// El frontend nunca recibe password_hash.
// ══════════════════════════════════════════════════════════════
function sha256Hex_(texto) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, texto, Utilities.Charset.UTF_8);
  return bytes.map(b => {
    const v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? '0' + v : v;
  }).join('');
}

function validarLogin(payload) {
  try {
    const usuario  = (payload.usuario  || '').toString().trim().toLowerCase();
    const password = (payload.password || '').toString();
    if (!usuario || !password) {
      return { ok: false, error: 'Ingresa usuario y contraseña.' };
    }

    const ss   = SpreadsheetApp.openById(SHEETS.desempeno);
    const hoja = ss.getSheetByName('Usuarios');
    if (!hoja) return { ok: false, error: 'Pestaña Usuarios no encontrada' };

    const datos    = hoja.getDataRange().getValues();
    if (datos.length < 2) return { ok: false, error: 'Usuario o contraseña incorrectos.' };

    const headers  = datos[0].map(h => h.toString().toLowerCase().trim());
    const idxUser  = headers.indexOf('usuario');
    const idxHash  = headers.indexOf('password_hash');
    if (idxUser < 0 || idxHash < 0) {
      return { ok: false, error: 'Configuración de usuarios incompleta (faltan columnas usuario/password_hash).' };
    }

    const hashIngresado = sha256Hex_(password);

    for (let r = 1; r < datos.length; r++) {
      const row = datos[r];
      const filaUsuario = (row[idxUser] || '').toString().trim().toLowerCase();
      if (filaUsuario === usuario) {
        const hashGuardado = (row[idxHash] || '').toString().trim();
        if (hashGuardado === hashIngresado) {
          // Solo se devuelven campos mínimos y seguros — NUNCA password_hash.
          const obj = {};
          headers.forEach((h, i) => { if (h !== 'password_hash') obj[h] = row[i] ? row[i].toString().trim() : ''; });
          return { ok: true, usuario: obj };
        }
        return { ok: false, error: 'Usuario o contraseña incorrectos.' };
      }
    }
    return { ok: false, error: 'Usuario o contraseña incorrectos.' };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// ══════════════════════════════════════════════════════════════
// USUARIOS
// ══════════════════════════════════════════════════════════════
function responderUsuarios() {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.desempeno);
    const hoja = ss.getSheetByName('Usuarios');
    if (!hoja) return { ok: false, error: 'Pestaña Usuarios no encontrada' };

    const datos = hoja.getDataRange().getValues();
    if (datos.length < 2) return { ok: true, usuarios: [] };

    const headers  = datos[0].map(h => h.toString().toLowerCase().trim());
    const usuarios = datos.slice(1)
      .filter(row => row[0])
      .map(row => {
        const obj = {};
        headers.forEach((h, i) => {
          // IMPORTANTE: nunca exponer password_hash al frontend. Esta pestaña
          // ahora solo se usa para listas de colaboradores y datos de perfil.
          if (h === 'password_hash') return;
          obj[h] = row[i] ? row[i].toString().trim() : '';
        });
        return obj;
      });

    return { ok: true, usuarios };

  } catch (err) {
    return { ok: false, error: err.message };
  }
}

