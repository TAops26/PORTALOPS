// ══════════════════════════════════════════════════════════════
// FOTOS — subida a Drive, organizada por categoría y mes
// ══════════════════════════════════════════════════════════════
// Estructura resultante dentro de DRIVE_FOTOS_FOLDER_ID:
//   Limpieza/2026-07/2026-07-08_maria-fernandez_1.jpg
//   Mantenimiento/2026-07/...
//   Averias/2026-07/...
//   Checklists/2026-07/...
//   Piscina/2026-07/...
//   Inventarios - ropa-cama/2026-07/...
//   Insumos - materiales/2026-07/...
//
// Devuelve { ok, urls, error }. Si CUALQUIER foto falla, se detiene y
// devuelve ok:false — nunca se reporta éxito parcial.
function procesarFotos_(fotos, categoria, colaborador) {
  if (!fotos || !fotos.length) return { ok: true, urls: [] };
  if (!DRIVE_FOTOS_FOLDER_ID || DRIVE_FOTOS_FOLDER_ID.indexOf('REEMPLAZAR') === 0) {
    return { ok: false, error: 'No se configuró la carpeta de Drive para fotos (DRIVE_FOTOS_FOLDER_ID).' };
  }
  try {
    const raiz = DriveApp.getFolderById(DRIVE_FOTOS_FOLDER_ID);
    const carpetaCategoria = obtenerOCrearSubcarpeta_(raiz, categoria || 'General');
    const hoy = new Date();
    const carpetaMes = obtenerOCrearSubcarpeta_(carpetaCategoria, Utilities.formatDate(hoy, 'America/Costa_Rica', 'yyyy-MM'));

    const fechaStr = Utilities.formatDate(hoy, 'America/Costa_Rica', 'yyyy-MM-dd_HHmmss');
    const colabSlug = sanitizarNombreArchivo_(colaborador || 'sin-colaborador');

    const urls = [];
    for (let i = 0; i < fotos.length; i++) {
      const foto = fotos[i];
      if (!foto || !foto.data) continue;
      const extension = extraerExtension_(foto.name, foto.mimeType);
      const nombreArchivo = `${fechaStr}_${colabSlug}_${i + 1}${extension}`;
      const blob = Utilities.newBlob(Utilities.base64Decode(foto.data), foto.mimeType || 'image/jpeg', nombreArchivo);
      const archivo = carpetaMes.createFile(blob);
      archivo.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      urls.push(archivo.getUrl());
    }
    return { ok: true, urls };
  } catch (err) {
    return { ok: false, error: 'Error al subir fotos a Drive: ' + err.message };
  }
}

// Busca una subcarpeta por nombre dentro de 'parent'; la crea si no existe.
function obtenerOCrearSubcarpeta_(parent, nombre) {
  const it = parent.getFoldersByName(nombre);
  if (it.hasNext()) return it.next();
  return parent.createFolder(nombre);
}

// Convierte un nombre de colaborador en un fragmento seguro para nombre de archivo.
function sanitizarNombreArchivo_(texto) {
  return String(texto)
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // quita acentos
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-+|-+$)/g, '') || 'colab';
}

function extraerExtension_(nombreOriginal, mimeType) {
  if (nombreOriginal && nombreOriginal.indexOf('.') > -1) {
    return '.' + nombreOriginal.split('.').pop().toLowerCase();
  }
  const porMime = { 'image/jpeg':'.jpg', 'image/png':'.png', 'image/webp':'.webp', 'image/heic':'.heic' };
  return porMime[mimeType] || '.jpg';
}

// ══════════════════════════════════════════════════════════════
// REPORTES
// ══════════════════════════════════════════════════════════════
function guardarReporte(payload) {
  try {
    const ss   = SpreadsheetApp.openById(SHEETS.reportes);
    const tipo = payload.tipo || '';
    const dept = payload.departamento || '';
    const datos = payload.datos || {};

    const ts     = new Date();
    const ts_str = Utilities.formatDate(ts, 'America/Costa_Rica', 'yyyy-MM-dd HH:mm:ss');

    // Categoría de carpeta para las fotos (Drive): agrupa por tipo de reporte
    // antes que por departamento, para que averías/checklists/piscina queden
    // juntas sin importar quién las reportó.
    let categoriaFotos;
    if (tipo === 'checklist') categoriaFotos = 'Checklists';
    else if (tipo === 'averia' || tipo === 'averia-cluster') categoriaFotos = 'Averias';
    else if (tipo === 'piscina') categoriaFotos = 'Piscina';
    else if (dept === 'mantenimiento') categoriaFotos = 'Mantenimiento';
    else if (dept === 'limpieza') categoriaFotos = 'Limpieza';
    else if (dept === 'seguridad') categoriaFotos = 'Seguridad';
    else if (dept === 'proveeduria') categoriaFotos = 'Proveeduria';
    else categoriaFotos = 'General';

    // Procesa fotos ANTES de escribir cualquier fila. Si falla, se aborta
    // todo el guardado y se informa el error real (no se marca éxito parcial).
    const fotosRes = procesarFotos_(datos.fotos, categoriaFotos, datos.colaborador);
    if (!fotosRes.ok) return { ok: false, error: fotosRes.error };
    const fotosUrls = fotosRes.urls.join(', ');

    // Checklists de inspección por cluster (mantenimiento) — hoja dedicada.
    // NOTA: en la versión anterior el payload de checklist no viajaba dentro
    // de "datos", por lo que guardarReporte() escribía filas casi vacías.
    // Se corrigió en el frontend (portal-ops.js) y aquí se maneja explícitamente.
    if (tipo === 'checklist') {
      let hojaCl = ss.getSheetByName('CHECKLISTS MANTENIMIENTO');
      if (!hojaCl) hojaCl = ss.insertSheet('CHECKLISTS MANTENIMIENTO');
      if (hojaCl.getLastRow() === 0) {
        hojaCl.appendRow(['Timestamp','Usuario','Departamento','Colaborador','Área','Fecha','Total Items','Completados','Observaciones','Items (JSON)','Fotos']);
      }
      hojaCl.appendRow([
        ts_str,
        payload.usuario      || '',
        payload.departamento || '',
        datos.colaborador    || '',
        datos.area           || '',
        datos.fecha          || '',
        datos.total          || 0,
        datos.completados    || 0,
        datos.observaciones  || '',
        datos.items ? JSON.stringify(datos.items) : '',
        fotosUrls,
      ]);
      return { ok: true };
    }

    let nombreHoja;
    if (tipo === 'reunion') {
      nombreHoja = 'REUNION DE OPERACIONES';
    } else if (tipo === 'averia' || tipo === 'averia-cluster') {
      nombreHoja = 'MANTENIMIENTO - REPORTE DE AVERÍA';
    } else if (dept === 'mantenimiento') {
      const mantoMap = {
        'trabajo':    'MANTENIMIENTO - REPORTE TRABAJO',
        'agua':       'MANTENIMIENTO - REPORTE DE AGUA',
        'piscina':    'MANTENIMIENTO - PISCINA',
        'materiales': 'MANTENIMIENTO - REPORTE TRABAJO',
      };
      nombreHoja = mantoMap[tipo] || 'INSPECCION CLUSTER';
    } else {
      const deptMap = {
        limpieza:   'Limpieza',
        seguridad:  'Seguridad',
        proveeduria:'Proveduría',
      };
      nombreHoja = deptMap[dept] || 'General';
    }

    let hoja = ss.getSheetByName(nombreHoja);
    if (!hoja) hoja = ss.insertSheet(nombreHoja);

    if (tipo === 'averia-cluster') {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Colaborador','Fecha','Avería','Prioridad','Área','Cluster','Descripción','Estado','ID','Fotos']);
      }
      const items = datos.items || [];
      items.forEach((item, i) => {
        const idUnico = 'AV-' + ts.getTime() + '-' + i;
        hoja.appendRow([
          ts_str,
          payload.usuario   || '',
          datos.colaborador || '',
          datos.fecha       || '',
          item.averia       || '',
          item.prioridad    || '',
          '',
          datos.cluster      || '',
          item.descripcion  || '',
          'Pendiente',
          idUnico,
          fotosUrls,
        ]);
      });

      let hojaLog = ss.getSheetByName('INSPECCION CLUSTER');
      if (!hojaLog) hojaLog = ss.insertSheet('INSPECCION CLUSTER');
      if (hojaLog.getLastRow() === 0) {
        hojaLog.appendRow(['Timestamp','Usuario','Colaborador','Fecha','Cluster','Averías Encontradas']);
      }
      hojaLog.appendRow([
        ts_str,
        payload.usuario   || '',
        datos.colaborador || '',
        datos.fecha       || '',
        datos.cluster      || '',
        items.length,
      ]);

      return { ok: true, registradas: items.length };
    }

    if (nombreHoja === 'MANTENIMIENTO - REPORTE TRABAJO') {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Departamento','Tipo','Colaborador','Fecha','Area','Estado','Prioridad','Descripcion','Materiales','Observaciones','Fotos']);
      }
      hoja.appendRow([
        ts_str,
        payload.usuario      || '',
        payload.departamento || '',
        payload.tipo         || '',
        datos.colaborador    || '',
        datos.fecha          || '',
        datos.area           || '',
        datos.estado         || '',
        datos.prior          || '',
        datos.desc           || '',
        datos.mat            || '',
        datos.obs            || '',
        fotosUrls,
      ]);

    } else if (nombreHoja === 'MANTENIMIENTO - REPORTE DE AGUA') {
      if (hoja.getLastRow() === 0) {
        hoja.appendRow(['Timestamp','Usuario','Area','Fecha','Reporte','Colaborador','M1','M2','M3','M4','M5','M6','M7','Observaciones','Fotos']);
      }
      hoja.appendRow([
        ts_str,
        payload.usuario      || '',
        datos.area           || '',
